# =============================================================================
# LearningHub Environment Variables Template (.env.example)
# Copy this file to .env before running application in prod/docker
# =============================================================================

# Active Spring Profile (dev / prod / test)
SPRING_PROFILE=dev

# Server Port (default 8080)
PORT=8080

# =============================================================================
# DATABASE (PostgreSQL) - Required in Prod profile
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=learninghub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Generate 256-bit key using: openssl rand -base64 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# =============================================================================
# EMAIL SERVICE (Brevo SMTP)
# =============================================================================
MAIL_USERNAME=your_brevo_smtp_login
MAIL_PASSWORD=your_brevo_smtp_password

# =============================================================================
# CLOUDINARY (Media Storage - Images & Videos)
# =============================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# =============================================================================
# GOOGLE DRIVE API (OAuth 2.0 - Document Storage)
# https://developers.google.com/oauthplayground lấy refresh token
# =============================================================================
GOOGLE_DRIVE_FOLDER_ID=1a2b3c4d5e6f7g8h9i0j
GOOGLE_DRIVE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_DRIVE_REFRESH_TOKEN=your_oauth_refresh_token

# =============================================================================
# REDIS CLOUD CONFIGURATION (Upstash / Redis Labs)
# =============================================================================
REDIS_HOST=glowing-donkey-12345.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_upstash_password
REDIS_SSL=true

# =============================================================================
# FRONTEND & CORS
# =============================================================================
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# ACADEMIC / REGISTRATION BUSINESS RULES
# =============================================================================
ATTENDANCE_MAX_ABSENT_RATIO=0.2
REG_MAX_CREDITS_PROBATION=14

# =============================================================================
# UNIVERSAL AI CONFIGURATION (Gemini / OpenAI / Groq / DeepSeek / Ollama)
# =============================================================================
# AI_API_KEY: Key từ Google Gemini, OpenAI, Groq, OpenRouter, DeepSeek, Ollama...
AI_API_KEY=your_ai_api_key_here

# AI_BASE_URL: Base URL nhà cung cấp AI:
# - Gemini (Mặc định): https://generativelanguage.googleapis.com/v1beta/models
# - OpenAI: https://api.openai.com/v1
# - Groq: https://api.groq.com/openai/v1
# - OpenRouter: https://openrouter.ai/api/v1
# - DeepSeek: https://api.deepseek.com/v1
# - Ollama (Local AI): http://localhost:11434/v1
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# AI_MODEL: Tên Model AI. Ví dụ: gemini-1.5-flash, gpt-4o-mini, llama-3.3-70b-versatile, deepseek-chat
AI_MODEL=gemini-1.5-flash
