# LearningHub Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
# Database phải tồn tại trước khi chạy backend.
DB_URL=jdbc:postgresql://localhost:5432/learninghub

# Database credentials
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Must be at least 256 bits (32 chars) for HS256 algorithm
# Generate with: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long

# Token expiration in milliseconds (default: 24 hours = 86400000)
JWT_EXPIRATION=86400000

# =============================================================================
# EMAIL SERVICE (Brevo SMTP)
# =============================================================================
# Get credentials from https://app.brevo.com/smtp/
MAIL_USERNAME=your_brevo_smtp_login
MAIL_PASSWORD=your_brevo_smtp_password

# SMTP server (already configured in application.yml)
# host: smtp-relay.brevo.com
# port: 587

# =============================================================================
# CLOUDINARY (Video Storage)
# =============================================================================
# Get credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# =============================================================================
# FRONTEND & CORS
# =============================================================================
# Frontend URL for password reset links, email templates, etc.
FRONTEND_URL=http://localhost:3000

# Comma-separated list of allowed origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# ATTENDANCE CONFIGURATION
# =============================================================================
# Maximum absent ratio before student fails (0.0 - 1.0)
# Default: 0.2 (20%)
ATTENDANCE_MAX_ABSENT_RATIO=0.4

# =============================================================================
# OPTIONAL: SERVER PORT (if not using default 8080)
# =============================================================================
# SERVER_PORT=8080
