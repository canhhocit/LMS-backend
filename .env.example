# =============================================================================
# LearningHub Environment Variables Template (.env.example)
# Copy this file to .env before running application in prod/docker
# =============================================================================

# Active Spring Profile (dev / prod / test)
SPRING_PROFILE=dev

# Server Port (default 8080)
PORT=8080

# =============================================================================
# DATABASE (PostgreSQL) - Required in Prod profile
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=learninghub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Generate 256-bit key using: openssl rand -base64 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# =============================================================================
# EMAIL SERVICE (Brevo SMTP)
# =============================================================================
MAIL_USERNAME=your_brevo_smtp_login
MAIL_PASSWORD=your_brevo_smtp_password

# =============================================================================
# CLOUDINARY (Media Storage)
# =============================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# =============================================================================
# FRONTEND & CORS
# =============================================================================
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# ACADEMIC / REGISTRATION BUSINESS RULES
# =============================================================================
ATTENDANCE_MAX_ABSENT_RATIO=0.2
REG_MAX_CREDITS_PROBATION=14
